{
  "openapi": "3.1.0",
  "info": {
    "title": "MultiCC bounded API",
    "version": "v1",
    "description": "Versioned, additive contract surface. Legacy unversioned routes remain available during migration."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/v1/sessions": {
      "get": {
        "operationId": "listSessionsV1",
        "responses": {
          "200": {
            "description": "Bounded session DTOs",
            "content": { "application/json": { "schema": { "$ref": "schemas/sessions-response.schema.json" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/sessions/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/SessionId" }],
      "get": {
        "operationId": "getSessionV1",
        "responses": {
          "200": {
            "description": "One bounded session DTO",
            "content": { "application/json": { "schema": { "$ref": "schemas/session-response.schema.json" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/directories/{id}/workspace": {
      "parameters": [{ "$ref": "#/components/parameters/DirectoryId" }],
      "get": {
        "operationId": "getWorkspaceV1",
        "responses": {
          "200": {
            "description": "Path-free workspace and bounded session facts",
            "content": { "application/json": { "schema": { "$ref": "schemas/workspace-response.schema.json" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/providers": {
      "get": {
        "operationId": "listProvidersV1",
        "parameters": [{
          "name": "appType", "in": "query", "required": false,
          "schema": { "enum": ["claude", "codex"] }
        }],
        "responses": {
          "200": {
            "description": "Credential-free provider summaries",
            "content": { "application/json": { "schema": { "$ref": "schemas/providers-response.schema.json" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/sessions/{id}/waits": {
      "parameters": [{ "$ref": "#/components/parameters/SessionId" }],
      "get": {
        "operationId": "listWaitsV1",
        "responses": {
          "200": {
            "description": "Wait status without commands, callback secrets, URLs or paths",
            "content": { "application/json": { "schema": { "$ref": "schemas/waits-response.schema.json" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/sessions/{id}/dispatch": {
      "parameters": [{ "$ref": "#/components/parameters/SessionId" }],
      "post": {
        "operationId": "dispatchV1",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "schemas/dispatch-request.schema.json" } } }
        },
        "responses": {
          "200": {
            "description": "Dispatch accepted",
            "content": { "application/json": { "schema": { "$ref": "schemas/dispatch-response.schema.json" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/voice-gateways": {
      "get": {
        "operationId": "listVoiceGatewaysV1",
        "responses": {
          "200": {
            "description": "Credential-free Fleet Voice Gateway bindings",
            "content": { "application/json": { "schema": { "$ref": "schemas/voice-gateways-response.schema.json" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/directories/{id}/voice-gateway": {
      "parameters": [{ "$ref": "#/components/parameters/DirectoryId" }],
      "get": {
        "operationId": "getVoiceGatewayV1",
        "responses": {
          "200": {
            "description": "One Fleet Voice Gateway binding",
            "content": { "application/json": { "schema": { "$ref": "schemas/voice-gateway-response.schema.json" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "operationId": "putVoiceGatewayV1",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "schemas/voice-gateway-upsert.schema.json" } } }
        },
        "responses": {
          "200": {
            "description": "Existing Voice Gateway updated",
            "content": { "application/json": { "schema": { "$ref": "schemas/voice-gateway-response.schema.json" } } }
          },
          "201": {
            "description": "Voice Gateway created",
            "content": { "application/json": { "schema": { "$ref": "schemas/voice-gateway-response.schema.json" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "deleteVoiceGatewayV1",
        "responses": {
          "200": {
            "description": "Voice Gateway removed",
            "content": { "application/json": { "schema": { "$ref": "schemas/voice-gateway-delete-response.schema.json" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/voice-runtime": {
      "get": {
        "operationId": "getQwenAudioRuntimeV1",
        "responses": {
          "200": {
            "description": "Path-free shared Qwen Audio runtime status",
            "content": { "application/json": { "schema": { "$ref": "schemas/qwen-audio-runtime-response.schema.json" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/voice-runtime/install": {
      "post": {
        "operationId": "installQwenAudioRuntimeV1",
        "responses": {
          "200": {
            "description": "Pinned runtime was already installed",
            "content": { "application/json": { "schema": { "$ref": "schemas/qwen-audio-runtime-response.schema.json" } } }
          },
          "202": {
            "description": "Pinned runtime installation started",
            "content": { "application/json": { "schema": { "$ref": "schemas/qwen-audio-runtime-response.schema.json" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/directories/{id}/voice-gateway/runtime": {
      "parameters": [{ "$ref": "#/components/parameters/DirectoryId" }],
      "get": {
        "operationId": "getQwenAudioFleetRuntimeV1",
        "responses": {
          "200": {
            "description": "One Fleet's supervised Qwen Audio process status",
            "content": { "application/json": { "schema": { "$ref": "schemas/qwen-audio-fleet-runtime-response.schema.json" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/directories/{id}/voice-gateway/restart": {
      "parameters": [{ "$ref": "#/components/parameters/DirectoryId" }],
      "post": {
        "operationId": "restartQwenAudioFleetRuntimeV1",
        "responses": {
          "200": {
            "description": "Fleet Qwen Audio process restarted",
            "content": { "application/json": { "schema": { "$ref": "schemas/qwen-audio-fleet-runtime-response.schema.json" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SessionId": {
        "name": "id", "in": "path", "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 160 }
      },
      "DirectoryId": {
        "name": "id", "in": "path", "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "responses": {
      "Error": {
        "description": "Safe error response with request correlation",
        "content": { "application/json": { "schema": { "$ref": "schemas/error.schema.json" } } }
      }
    }
  }
}
