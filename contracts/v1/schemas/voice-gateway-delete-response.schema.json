{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multicc.local/contracts/v1/voice-gateway-delete-response.schema.json",
  "title": "Fleet Voice Gateway delete response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "requestId", "correlationId", "ok", "id", "directoryId"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "ok": { "const": true },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "directoryId": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
