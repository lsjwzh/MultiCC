{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multicc.local/contracts/v1/provider.schema.json",
  "title": "Provider DTO v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "appType", "protocol", "wireApi", "name", "source", "model", "modelOptions", "aliasOnly", "hasCredentials", "isOfficial"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "appType": { "enum": ["claude", "codex"] },
    "protocol": { "enum": ["anthropic", "openai", "openai_responses"] },
    "apiFormat": { "enum": ["anthropic", "openai_responses"] },
    "wireApi": { "type": ["string", "null"], "enum": ["messages", "responses", null] },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source": { "enum": ["local", "ccswitch"] },
    "model": { "type": ["string", "null"], "maxLength": 160 },
    "modelOptions": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 160 } },
    "aliasOnly": { "type": "boolean" },
    "compatibleClis": { "type": "array", "uniqueItems": true, "maxItems": 4, "items": { "enum": ["claude", "codex", "opencode", "zcode", "kimi"] } },
    "hasCredentials": { "type": "boolean" },
    "isOfficial": { "type": "boolean" }
  }
}
