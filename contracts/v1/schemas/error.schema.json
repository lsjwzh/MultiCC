{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multicc.local/contracts/v1/error.schema.json",
  "title": "Error response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "requestId", "correlationId", "ok", "error", "code"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "ok": { "const": false },
    "error": { "type": "string", "minLength": 1, "maxLength": 240 },
    "code": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" }
  }
}
