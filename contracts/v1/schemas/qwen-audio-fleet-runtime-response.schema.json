{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multicc.local/contracts/v1/qwen-audio-fleet-runtime-response.schema.json",
  "title": "Qwen Audio Fleet process response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "requestId", "correlationId", "ok", "runtime"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "ok": { "const": true },
    "runtime": { "$ref": "qwen-audio-fleet-runtime.schema.json" }
  }
}
