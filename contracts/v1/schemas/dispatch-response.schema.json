{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multicc.local/contracts/v1/dispatch-response.schema.json",
  "title": "Dispatch response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "requestId", "correlationId", "ok", "target", "chatId", "note"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "ok": { "const": true },
    "target": { "type": "string", "minLength": 1, "maxLength": 160 },
    "chatId": { "type": ["string", "null"], "maxLength": 160 },
    "note": { "type": ["string", "null"], "maxLength": 240 }
  }
}
