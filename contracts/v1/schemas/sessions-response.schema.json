{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multicc.local/contracts/v1/sessions-response.schema.json",
  "title": "Sessions response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "requestId", "correlationId", "sessions", "count"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "sessions": { "type": "array", "items": { "$ref": "session.schema.json" } },
    "count": { "type": "integer", "minimum": 0 }
  }
}
