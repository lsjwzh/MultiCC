  "rejectedByBridge": [
    {
      "name": "truncated pointer",
      "hex": "0501000a",
      "why": "定长消息少一个字节：转发出去 Agent 会把下一条消息的头当坐标读",
      "agentCalls": []
    },
    {
      "name": "two pointers in one message",
      "hex": "050100010001050000020002",
      "why": "桥只认单条定长消息；拼包的客户端必须拆开发（Agent 是流式读取，会照单全收成两条 —— 消息边界只有桥这一道闸）",
      "agentCalls": [
        "pointer 1 1 1",
        "pointer 0 2 2"
      ]
    },
    {
      "name": "RFB FramebufferUpdateRequest",
      "hex": "03000000000000000000",
      "why": "H.264 通道没有 RFB 帧请求",
      "agentCalls": []
    },
    {
      "name": "unknown type",
      "hex": "09",
      "why": "未知类型一律丢弃",
      "agentCalls": []
    },
    {
      "name": "truncated cap",
      "hex": "42000005",
      "why": "定长消息少一个字节：Agent 会把后面那条消息的头当 kbps 读",
      "agentCalls": []
    },
    {
      "name": "cap and pointer in one message",
      "hex": "42000005dc050100010002",
      "why": "桥只认单条定长消息；Agent 是流式读取，会照单全收成 cap + pointer",
      "agentCalls": [
        "cap 1500",
        "pointer 1 1 2"
      ]
    }
  ],
  "decodedScaling": [
