{
  "name": "multicc",
  "version": "0.9.9",
  "description": "Web interface for Claude Code CLI",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tests/test.js && node --test tests/test-sqlite-runtime.js && node tests/test-native-deps.js",
    "test:cli-switch": "node tests/test-cli-switch.js && node tests/test-cli-adapters.js && node tests/test-message-composer-golden.js && node tests/test-chat-stream-resume.js && node tests/test-cli-switch-api.js && node tests/test-cli-switch-failclosed.js && node tests/test-cli-specific-ui.js",
    "test:subagent-routing": "node tests/test-claude-subagent-routing.js",
    "test:subagent-live": "node tests/test-claude-subagent-live.js",
    "test:codex-subagent-routing": "node tests/test-codex-subagent-routing.js",
    "test:codex-subagent-live": "node tests/test-codex-subagent-live.js",
    "test:git-push": "node tests/test-git-push.js",
    "test:power": "node tests/test-macos-power.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@slack/bolt": "^4.2.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "cli-provider-router": "https://github.com/lsjwzh/cli-provider-router/archive/328bfb4a6aec83f5662e02be4485c788982320d2.tar.gz",
    "discord.js": "^14.16.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-pty": "^1.0.0",
    "node-telegram-bot-api": "^0.66.0",
    "web-push": "^3.6.7",
    "ws": "^8.16.0"
  }
}
