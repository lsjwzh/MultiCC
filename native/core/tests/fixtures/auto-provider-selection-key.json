{
  "comment": [
    "Frozen behaviour of src/chat/auto-provider-selection-key.js (2026-11-11).",
    "Normalization runs in the retained auto-provider config bridge; this file",
    "only pins which policy changes do and do not reset a session route.",
    "Each call records its normalized selection so the Rust key derivation",
    "can be replayed without the cross-module facts the JS bridge assembles."
  ],
  "cases": [
    {
      "name": "omitted defaults normalize to the same key as explicit defaults",
      "op": "selectionKey",
      "calls": [
        {
          "label": "omitted",
          "input": {
            "mode": "auto",
            "candidates": [
              {
                "providerId": "a",
                "priority": 1
              },
              {
                "providerId": "b",
                "priority": 2
              }
            ]
          },
          "normalized": {
            "version": 1,
            "mode": "auto",
            "protocol": "anthropic",
            "candidates": [
              {
                "providerId": "a",
                "model": null,
                "priority": 1,
                "enabled": true
              },
              {
                "providerId": "b",
                "model": null,
                "priority": 2,
                "enabled": true
              }
            ],
            "maxAttempts": 2,
            "sticky": true,
            "preferMaxQuota": true,
            "allowCrossTrust": false
          }
        },
        {
          "label": "explicit",
          "input": {
            "mode": "auto",
            "candidates": [
              {
                "providerId": "a",
                "priority": 1
              },
              {
                "providerId": "b",
                "priority": 2
              }
            ],
            "version": 1,
            "preferMaxQuota": true,
            "sticky": true,
            "maxAttempts": 2
          },
          "normalized": {
            "version": 1,
            "mode": "auto",
            "protocol": "anthropic",
            "candidates": [
              {
                "providerId": "a",
                "model": null,
                "priority": 1,
                "enabled": true
              },
              {
                "providerId": "b",
                "model": null,
                "priority": 2,
                "enabled": true
              }
            ],
            "maxAttempts": 2,
            "sticky": true,
            "preferMaxQuota": true,
            "allowCrossTrust": false
          }
        }
      ],
      "same": [
        [
          "omitted",
          "explicit"
        ]
      ],
      "expect": {
        "keys": {
          "omitted": "{\"version\":1,\"mode\":\"auto\",\"protocol\":\"anthropic\",\"candidates\":[{\"providerId\":\"a\",\"model\":null,\"priority\":1,\"enabled\":true},{\"providerId\":\"b\",\"model\":null,\"priority\":2,\"enabled\":true}],\"maxAttempts\":2,\"sticky\":true,\"preferMaxQuota\":true,\"allowCrossTrust\":false}",
          "explicit": "{\"version\":1,\"mode\":\"auto\",\"protocol\":\"anthropic\",\"candidates\":[{\"providerId\":\"a\",\"model\":null,\"priority\":1,\"enabled\":true},{\"providerId\":\"b\",\"model\":null,\"priority\":2,\"enabled\":true}],\"maxAttempts\":2,\"sticky\":true,\"preferMaxQuota\":true,\"allowCrossTrust\":false}"
        },
        "equal": {
          "omitted=explicit": true
        }
      }
    },
