# secrets.json 是敏感信息保险箱的落盘处（src/paths.js secretsFile，0600）：明文
# 只在这里，注入子进程当环境变量用。运行时会先在旁边写 secrets.json.tmp.<pid>.<n>
# 再 rename，进程死在中间就会留下一个装着全部明文的临时文件，所以两个名字都要挡。
secrets.json
secrets.json.tmp.*
external-fleets.json
aux-config.json
aux_runs/
notes.json
ui-layout.json
chat_history/
events/
logs/
artifacts/
detached/
# 跨文件事务日志目录（src/paths.js journalDir）：事务中途会留下状态文件的片段
.journal/
# 桥接（IM 通道）运行时数据目录
bridges/
.multicc.pid
# Pre-update version marker written by ./multicc update, read once by the new
# process to run one-time data migrations, plus that migration's applied marker.
.multicc_upgrade
cron_fanout_migration.json
# Token 统计为运行时状态，服务持续改写；跟踪它们会让工作区永远 dirty、挡住 ./multicc update
token_usage.json
token_daily.json
token_by_role.json
# Local tool config
.claude/
# ZCode 工作区配置由 router MCP 注入按会话改写（含短时效 capability token），保持本地
.zcode/
push_subscriptions.json
push_notification_receipts.json
voice_examples.json
wechat-config.json
phtunnel-monitor.sh

# Certificates (local-generated)
cert.pem
key.pem

# Backup files
*.bak
*.bak[0-9]*
app_capacitor_bak/

# Flutter build artifacts
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Build artifacts
/*.apk
# Published APK, generated metadata and interrupted atomic-publish temps are
# local install artifacts. One prefix keeps every member of the set untracked.
public/multicc.apk*
# Published iOS IPA + sidecar for the OTA channel (scripts/publish-ipa.sh).
public/multicc-ios.ipa*
app/node_modules/
app/android/app/build/
app/android/build/
app/android/.gradle/
app/android/capacitor-cordova-android-plugins/build/
app/android/local.properties
app/android/app/src/main/assets/public/
app/android/app/src/main/assets/capacitor.config.json
app/android/app/src/main/assets/capacitor.plugins.json
app/android/app/src/main/res/xml/config.xml
app/ios/App/App/public/
app/ios/App/App/capacitor.config.json
app/ios/App/App/config.xml
app/ios/App/Pods/
app/ios/App/build/
app/ios/DerivedData/

