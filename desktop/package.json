{
  "name": "multicc-desktop",
  "productName": "MultiCC",
  "private": true,
  "version": "2.0.6",
  "description": "MultiCC desktop shell — supervises the local MultiCC server and hosts its web UI",
  "homepage": "https://github.com/lsjwzh/MultiCC#readme",
  "main": "main.js",
  "author": "MultiCC Team",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "start": "electron .",
    "stage:resources": "node ../scripts/desktop-stage-standalone.js --out .staging/resources --install",
    "dist": "npm run stage:resources && electron-builder --publish never",
    "dist:mac": "npm run stage:resources && electron-builder --publish never --mac",
    "dist:win": "npm run stage:resources && electron-builder --publish never --win",
    "dist:linux": "npm run stage:resources && electron-builder --publish never --linux"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.lsjwzh.multicc",
    "productName": "MultiCC",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".staging/resources/app-server",
        "to": "app-server",
        "filter": ["**/*"]
      },
      {
        "from": ".staging/resources/runtime",
        "to": "runtime",
        "filter": ["**/*"]
      },
      {
        "from": ".staging/resources/launcher",
        "to": "launcher",
        "filter": ["**/*"]
      },
      {
        "from": ".staging/resources/bundle-manifest.json",
        "to": "bundle-manifest.json"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "artifactName": "multicc-desktop-${version}-macos-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": true,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "MultiCC 需要访问「桌面」才能把工作目录设在这里。",
        "NSDocumentsFolderUsageDescription": "MultiCC 需要访问「文档」才能把工作目录设在这里。",
        "NSDownloadsFolderUsageDescription": "MultiCC 需要访问「下载」才能把工作目录设在这里。",
        "NSRemovableVolumesUsageDescription": "MultiCC 需要访问外接磁盘才能把工作目录设在这里。",
        "NSNetworkVolumesUsageDescription": "MultiCC 需要访问网络磁盘才能把工作目录设在这里。"
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "multicc-desktop-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "MultiCC Team <lsjwzh@users.noreply.github.com>",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "multicc-desktop-${version}-linux-x64.${ext}"
    },
    "publish": null
  }
}
