#!/bin/bash
# MultiCC service manager — start/stop/restart/log
# Usage: ./multicc start|stop|restart|status|log|update [--force]|install|uninstall

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LABEL="com.multicc.server"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG_DIR="$SCRIPT_DIR/logs"
OUT_LOG="$LOG_DIR/multicc.log"
ERR_LOG="$LOG_DIR/multicc-error.log"
PID_FILE="$SCRIPT_DIR/.multicc.pid"

# Resolve the node binary. Auto-detect from PATH (covers Homebrew on both
# Apple Silicon and Intel, nvm/fnm, system installs); fall back to the common
# install locations. Override with MULTICC_NODE=/path/to/node if needed.
if [ -n "${MULTICC_NODE:-}" ] && [ -x "${MULTICC_NODE:-}" ]; then
  NODE="$MULTICC_NODE"
elif command -v node >/dev/null 2>&1; then
  NODE="$(command -v node)"
else
  NODE=""
  for _n in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
    [ -x "$_n" ] && NODE="$_n" && break
  done
fi
if [ -z "$NODE" ] || [ ! -x "$NODE" ]; then
  echo "Error: could not find a 'node' binary. Install Node.js >= 20.19," >&2
  echo "       or set MULTICC_NODE=/full/path/to/node and retry." >&2
  exit 1
fi

# Warn (but do not block) when node is older than the floor in package.json.
# chokidar 5 is pure ESM and needs the require(ESM) backport that landed in
# Node 20.19 / 22.12 — without it the server dies with a bare ERR_REQUIRE_ESM.
_node_ver="$("$NODE" -v 2>/dev/null | sed 's/^v//')"
_node_major="${_node_ver%%.*}"
_node_rest="${_node_ver#*.}"
_node_minor="${_node_rest%%.*}"
case "$_node_major" in
  ''|*[!0-9]*) ;;  # unparseable — say nothing
  *)
    if [ "$_node_major" -lt 20 ] || { [ "$_node_major" -eq 20 ] && [ "${_node_minor:-0}" -lt 19 ]; }; then
      echo "Warning: Node $_node_ver is below the required >= 20.19 ($NODE)." >&2
      echo "         MultiCC will likely fail with ERR_REQUIRE_ESM (chokidar 5)." >&2
      echo "         Upgrade Node, or point MULTICC_NODE at a newer binary." >&2
    fi
    ;;
esac

mkdir -p "$LOG_DIR"

# ── Helpers ──
is_running() {
  if [ -f "$PID_FILE" ]; then
    local pid=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  # Also check by process
  pgrep -f "node $SCRIPT_DIR/server.js" >/dev/null 2>&1
}

get_pid() {
  if [ -f "$PID_FILE" ]; then
    cat "$PID_FILE" 2>/dev/null
    return
  fi
  pgrep -f "node $SCRIPT_DIR/server.js" 2>/dev/null | head -1
}

check_runtime_dependencies() {
  local check_rc=0
  "$NODE" "$SCRIPT_DIR/scripts/check-runtime-deps.js" || check_rc=$?
  if [ "$check_rc" -eq 0 ]; then
    return 0
  fi

  if [ "$check_rc" -eq 10 ]; then
    echo "better-sqlite3 native binding is unavailable — rebuilding it once..."
    if (cd "$SCRIPT_DIR" && env PATH="$(dirname "$NODE"):$PATH" npm rebuild better-sqlite3 --foreground-scripts 2>&1); then
      check_rc=0
      "$NODE" "$SCRIPT_DIR/scripts/check-runtime-deps.js" || check_rc=$?
      [ "$check_rc" -eq 0 ] && return 0
    fi
  fi
  return "$check_rc"
}

# An update is not complete merely because the new process stayed alive: boot
# now runs the idempotent Fleet Commander compatibility migration.  Wait for
# /readyz so `./multicc update` reports a degraded migration instead of a false
# success. The server still listens on failure so operators can inspect/repair
# the directoryId entries returned by readiness.
wait_for_ready() {
  local port="${PORT:-}" probe="" url
  if [ -z "$port" ]; then
    port="$("$NODE" -e 'const fs=require("fs");let s="";try{s=fs.readFileSync(process.argv[1],"utf8")}catch{};const m=s.match(/^PORT\s*=\s*([^\s#]+)\s*$/m);process.stdout.write(m?m[1]:"3000")' "$SCRIPT_DIR/.env")"
  fi
  url="http://127.0.0.1:${port}/readyz"
  echo "Waiting for startup migrations and readiness..."
  for _i in $(seq 1 120); do
    if probe="$("$NODE" -e '(async()=>{for(const u of [process.argv[1],process.argv[2]]){try{const r=await fetch(u);const t=await r.text();process.stdout.write(t.slice(0,2000));process.exit(r.status===200?0:2)}catch{}}process.exit(3)})()' "$url" "http://[::1]:${port}/readyz" 2>/dev/null)"; then
      echo "MultiCC readiness confirmed."
      return 0
    fi
    sleep 0.5
  done
  echo "MultiCC restarted but readiness did not become healthy."
  [ -n "$probe" ] && echo "Readiness report: $probe"
  echo "Check $ERR_LOG; Commander migration failures include their directoryId."
  return 1
}

do_start() {
  if is_running; then
    echo "MultiCC is already running (PID $(get_pid))"
    return 1
  fi
  echo "Verifying runtime dependencies..."
  if ! check_runtime_dependencies; then
    echo "Runtime dependency verification failed — MultiCC was not started."
    echo "Run './multicc update' to repair missing or outdated packages."
    return 1
  fi
  echo "Starting MultiCC..."
  cd "$SCRIPT_DIR"
  nohup "$NODE" server.js >> "$OUT_LOG" 2>> "$ERR_LOG" &
  local pid=$!
  echo $pid > "$PID_FILE"
  sleep 1
  if kill -0 $pid 2>/dev/null; then
    echo "MultiCC started (PID $pid)"
    echo "Log: $OUT_LOG"
  else
    echo "Failed to start. Check $ERR_LOG"
    rm -f "$PID_FILE"
    return 1
  fi
}

do_stop() {
  # Collect EVERY live node running THIS worktree's server.js (pidfile + pgrep,
  # de-duped). Killing only get_pid's single pid misses survivors — a stale
  # pidfile plus multiple node server.js processes is exactly how zombies
  # accumulate and wedge /api/restart ("already in progress" forever after one
  # failed detached restart leaves the live process with _restartScheduled=true).
  local pids=""
  if [ -f "$PID_FILE" ]; then
    local pf
    pf=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$pf" ] && kill -0 "$pf" 2>/dev/null; then pids="$pf"; fi
  fi
  local extra
  extra=$(pgrep -f "node $SCRIPT_DIR/server.js" 2>/dev/null)
  if [ -n "$extra" ]; then
    pids=$(printf '%s\n%s\n' "$pids" "$extra" | grep -v '^$' | sort -u | tr '\n' ' ')
  fi
  pids=$(echo "$pids" | xargs)
  if [ -z "$pids" ]; then
    echo "MultiCC is not running"
    rm -f "$PID_FILE"
    return 0
  fi
  echo "Stopping MultiCC (PID(s): $pids)..."
  # SIGINT triggers server.js gracefulShutdown (drain in-flight turns + flush
  # partial chats). SIGTERM is deliberately ignored by the server, so we must
  # send -INT here; the -9 below stays as a hard fallback if the drain overruns.
  for p in $pids; do kill -INT "$p" 2>/dev/null; done
  # Wait up to ~65s for graceful shutdown (matches server SHUTDOWN_GRACE_MS=60s)
  for i in $(seq 1 130); do
    local alive=""
    for p in $pids; do
      kill -0 "$p" 2>/dev/null && alive="$alive $p"
    done
    [ -z "$(echo "$alive" | xargs)" ] && break
    sleep 0.5
    pids="$alive"
  done
  # Force kill any survivors
  for p in $pids; do
    kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null
  done
  rm -f "$PID_FILE"
  echo "MultiCC stopped"
}

do_restart() {
  do_stop
  sleep 1
  do_start
}

do_status() {
  if is_running; then
    echo "MultiCC is running (PID $(get_pid))"
  else
    echo "MultiCC is not running"
  fi
}

do_log() {
  if [ ! -f "$OUT_LOG" ]; then
    echo "No log file yet"
    return
  fi
  tail -f "$OUT_LOG" "$ERR_LOG"
}

do_update() {
  cd "$SCRIPT_DIR" || { echo "Cannot cd to $SCRIPT_DIR"; return 1; }

  # ── Flags ────────────────────────────────────────────────────────────
  # A running server rewrites runtime-state files constantly, so the working
  # tree is dirty far more often than not. The default path stashes and
  # restores those changes; --force is for when that restore cannot succeed
  # (conflicts with what upstream changed) and the user wants upstream's
  # version regardless. Force still takes a backup — it discards the tree,
  # not the ability to get it back.
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -h|--help)
        echo "Usage: ./multicc update [--force]"
        echo ""
        echo "  (no flag)   Stash local changes, fast-forward, restore them, restart."
        echo "              Stops if the restore conflicts, leaving your work in the stash."
        echo "  --force,-f  Update even when the working tree is dirty or has diverged."
        echo "              Local changes are backed up to a git stash and NOT restored;"
        echo "              the tree is reset to origin. Recover with: git stash list"
        return 0 ;;
      *)
        echo "Unknown option for update: $1" >&2
        echo "Usage: ./multicc update [--force]" >&2
        return 1 ;;
    esac
    shift
  done

  if [ ! -d .git ]; then
    echo "Not a git checkout ($SCRIPT_DIR) — cannot self-update."
    echo "Re-run the install script to update."
    return 1
  fi

  # Repair incomplete installs even when git is already current. This covers
  # both native bindings and the split-out cli-provider-router package, so an
  # interrupted v1 upgrade can recover by simply rerunning `./multicc update`.
  echo "Verifying current runtime dependencies..."
  if ! check_runtime_dependencies; then
    echo "Runtime dependencies are incomplete or outdated — running npm install..."
    if ! env PATH="$(dirname "$NODE"):$PATH" npm install 2>&1 || ! check_runtime_dependencies; then
      echo "Runtime dependency repair failed — update was not started."
      return 1
    fi
  fi

  # ── Resolve the release channel ──────────────────────────────────────
  # .multicc_channel is written by install.sh.  If absent we default to "dev"
  # for backwards-compatibility with older installations that pre-date this
  # file (they were all cloned from main).
  local channel="dev"
  if [ -f ".multicc_channel" ]; then
    channel="$(grep '^# channel:' .multicc_channel 2>/dev/null | awk '{print $3}' || echo "dev")"
  fi

  # ── Fetch remote tags & latest release info ──────────────────────────
  echo "Checking for updates..."

  git fetch origin --tags 2>/dev/null || true

  local latest_tag latest_version local_version
  latest_tag=""
  latest_version="0.0.0"

  # Query the GitHub Releases API for the latest release (stable channel).
  # Fall back to the highest semver tag if the API is unreachable.
  local api_resp
  api_resp="$(curl -sf --connect-timeout 10 --max-time 15 \
    "https://api.github.com/repos/lsjwzh/MultiCC/releases/latest" 2>/dev/null)" || true
  if [ -n "$api_resp" ]; then
    latest_tag="$(echo "$api_resp" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    if [ -z "$latest_tag" ]; then
      latest_tag="$(echo "$api_resp" | sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p')"
    fi
  fi

  # Fallback: highest semver-like tag from git
  if [ -z "$latest_tag" ]; then
    latest_tag="$(git tag -l 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null | sort -V | tail -1)" || true
  fi
  if [ -n "$latest_tag" ]; then
    latest_version="$(echo "$latest_tag" | sed 's/^v//')"
  fi

  # Read the locally installed version.
  # For stable channel: prefer the currently-checked-out tag (if on one).
  # For dev channel: use package.json version.
  local_version=""
  # forced_reset records that --force threw away on-disk changes. HEAD may not
  # move in that case, but the files the server runs did — so it still needs a
  # restart, and the "nothing to do" shortcut below must not fire.
  local before after stashed=0 forced_reset=0 merge_base local_tip origin_tip
  before="$(git rev-parse HEAD 2>/dev/null)"

  if [ "$channel" = "stable" ]; then
    local_version="$(git describe --tags --exact-match 2>/dev/null | sed 's/^v//')" || true
  fi
  if [ -z "$local_version" ]; then
    local_version="$(node -e "try{process.stdout.write(require('./package.json').version||'0.0.0')}catch(e){process.stdout.write('0.0.0')}" 2>/dev/null)" || local_version="0.0.0"
  fi

  echo "  Local:    v${local_version}   (channel: ${channel})"
  echo "  Latest:   ${latest_tag:-none}"

  # ── Version comparison ───────────────────────────────────────────────
  compare_versions() {
    # Returns: 0 (true) if $1 < $2, 1 (false) if $1 >= $2
    [ "$1" = "$2" ] && return 1
    [ "$(printf '%s\n' "$1" "$2" | sort -V | head -1)" = "$1" ] && return 0
    return 1
  }

  if [ "$channel" = "stable" ]; then
    # Stable channel: only update when a newer release tag exists.
    if [ -z "$latest_tag" ]; then
      echo "No release tags found — nothing to update."
      return 0
    fi
    if compare_versions "$local_version" "$latest_version"; then
      echo "Newer release available: ${latest_tag} → updating..."
    else
      echo "Already on the latest release (${latest_tag})."
      if [ "$force" = 1 ]; then
        # This gate runs before --force is consulted, so -f is a no-op here: there
        # is no newer release to move to. Say so, or a user who ran it to get a
        # clean checkout reads the early exit as "force silently did nothing".
        echo "  --force has no newer release to update to."
        echo "  To discard local changes and re-checkout this release:"
        echo "    git checkout -f ${latest_tag}"
      fi
      return 0
    fi
    # Update: checkout the tag. Under --force, back the tree up first and then
    # let checkout overwrite it — the backup is what makes -f recoverable.
    if [ "$force" = 1 ] && [ -n "$(git status --porcelain 2>/dev/null)" ]; then
      if git stash push --include-untracked -m "multicc-force-update-$(date +%Y%m%d-%H%M%S)" >/dev/null 2>&1; then
        echo "Local changes backed up to a stash (recover with: git stash list)."
      else
        echo "Could not stash local changes — continuing, as --force was requested."
      fi
    fi
    local checkout_ok=0
    if [ "$force" = 1 ]; then
      git checkout -f "$latest_tag" 2>/dev/null && checkout_ok=1
    else
      git checkout "$latest_tag" 2>/dev/null && checkout_ok=1
    fi
    if [ "$checkout_ok" != 1 ]; then
      echo "Could not checkout ${latest_tag} — the local tree may have conflicts."
      if [ "$force" = 1 ]; then
        echo "Run: git fetch origin --tags && git checkout -f ${latest_tag}"
      else
        echo "Run: git fetch origin --tags && git checkout ${latest_tag}"
        echo "Or retry with: ./multicc update --force"
      fi
      return 1
    fi
    echo "Switched to ${latest_tag}."
    after="$(git rev-parse HEAD 2>/dev/null)"
  else
    # Dev channel (main): pull the latest main.
    # Warn if a newer release exists that the user might prefer.
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"

    if compare_versions "$local_version" "$latest_version"; then
      echo ""
      echo "  ⚠️  A newer stable release (${latest_tag}) is available."
      echo "     You are on the '${branch}' development branch."
      echo "     To switch to stable:  git checkout ${latest_tag}"
      echo ""
    elif [ "$local_version" != "0.0.0" ] && [ "$latest_version" != "0.0.0" ]; then
      echo "  Local version (v${local_version}) >= latest release (${latest_tag})"
    fi

    # Proceed with the existing git-pull-on-main logic (preserved below).
    # The running server constantly rewrites runtime-state files, so the working
    # tree is almost never clean. Instead of aborting, stash local changes (tracked
    # + untracked), fast-forward, then restore them — no manual commit/stash needed.
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
      if [ "$force" = 1 ]; then
        # Force never restores the stash, so label it with a timestamp: it is a
        # backup the user goes looking for, not a step in this run.
        echo "Working tree has local changes — backing them up (force update)..."
        if git stash push --include-untracked -m "multicc-force-update-$(date +%Y%m%d-%H%M%S)" >/dev/null 2>&1; then
          echo "  Backed up. Recover with: git stash list / git stash pop"
        else
          echo "  Could not stash — continuing anyway, as --force was requested."
        fi
        forced_reset=1
      else
        echo "Working tree has local changes — stashing them before update..."
        if ! git stash push --include-untracked -m "multicc-auto-update" >/dev/null 2>&1; then
          echo "git stash failed — resolve your working tree manually, then retry."
          echo "Or discard local changes and update anyway: ./multicc update --force"
          return 1
        fi
        stashed=1
      fi
    fi

    echo "Updating MultiCC (branch: $branch)..."

    # Fetch latest from remote.
    git fetch origin "$branch" 2>/dev/null

    # Check if a fast-forward is possible. If the local branch has diverged
    # from origin (e.g. after a server-side history rewrite / force-push),
    # fall back to a hard reset to origin's tip. This ensures existing users
    # can always update even when the commit history was rewritten.
    local_tip="$(git rev-parse HEAD 2>/dev/null)"
    origin_tip="$(git rev-parse "origin/$branch" 2>/dev/null)"
    merge_base="$(git merge-base "$local_tip" "$origin_tip" 2>/dev/null)"

    if [ "$force" = 1 ]; then
      # Force means "end on origin's tip", whatever the local history is: ahead,
      # behind, or diverged. Anything worth keeping is already in the stash above.
      if [ -z "$origin_tip" ]; then
        echo "Could not resolve origin/$branch — check the network, then retry."
        return 1
      fi
      if [ "$local_tip" = "$origin_tip" ]; then
        echo "Already on origin/$branch — resetting the working tree to it."
      else
        echo "Force update — resetting to origin/$branch..."
        echo "  (local: ${local_tip:0:7} → origin: ${origin_tip:0:7})"
      fi
      if ! git reset --hard "$origin_tip"; then
        echo "git reset --hard failed — resolve the repository state manually."
        return 1
      fi
    elif [ "$merge_base" = "$local_tip" ]; then
      # Local is an ancestor of origin — fast-forward is safe.
      if ! git pull --ff-only origin "$branch"; then
        echo "git pull failed (network issue) — retry later."
        [ "$stashed" = 1 ] && git stash pop >/dev/null 2>&1
        return 1
      fi
    elif [ "$merge_base" = "$origin_tip" ]; then
      # Local is ahead of origin — nothing to pull. Say how to get onto origin
      # anyway: someone who committed a local experiment reads "nothing to
      # update" as "I am current", when in fact they are off the release line.
      echo "Local branch is ahead of origin — nothing to update."
      echo "  To discard the local commits and take origin's code: ./multicc update --force"
      [ "$stashed" = 1 ] && git stash pop >/dev/null 2>&1
      return 0
    else
      # Diverged histories (force-push on the server side).
      # Hard-reset to origin to sync with the rewritten history.
      echo "Remote history was rewritten — resetting to origin/$branch..."
      echo "  (local: ${local_tip:0:7} → origin: ${origin_tip:0:7})"
      git reset --hard "origin/$branch"
      # Stashed changes are likely obsolete after reset; drop them.
      if [ "$stashed" = 1 ]; then
        echo "  Note: local changes were stashed but may no longer apply after reset."
        echo "  Run 'git stash list' to see them, or 'git stash drop' to discard."
      fi
    fi

    # Restore the stashed local changes on top of the freshly pulled code
    # (only for the fast-forward path; the hard-reset path handled stash above).
    if [ "$stashed" = 1 ] && [ "$merge_base" = "$local_tip" ]; then
      if ! git stash pop >/dev/null 2>&1; then
        echo "⚠️  Update pulled successfully, but your local changes conflict with it."
        echo "   Your changes are safe in 'git stash' (run: git stash list / git stash pop)."
        echo "   Resolve the conflict, then restart with './multicc restart'."
        echo "   Or take the new code and keep the changes only as a stash:"
        echo "     ./multicc update --force"
        return 1
      fi
    fi

    after="$(git rev-parse HEAD 2>/dev/null)"
    if [ "$before" = "$after" ] && [ "$forced_reset" != 1 ]; then
      echo "Already up to date — nothing to restart."
      return 0
    fi
    if [ "$before" = "$after" ]; then
      echo "Already on the latest commit — restarting anyway to drop the discarded local changes."
    fi
  fi

  # ── Reinstall deps when manifests changed (both channels) ─────────────
  if [ -n "${after:-}" ] && [ "$before" != "${after:-}" ]; then
    if git diff --name-only "$before" "${after:-}" | grep -qE '^package(-lock)?\.json$'; then
      echo "Dependencies changed — running npm install..."
      if ! env PATH="$(dirname "$NODE"):$PATH" npm install 2>&1; then
        echo "npm install failed — fix the error above, then re-run './multicc update'."
        return 1
      fi
    fi
  fi

  echo "Verifying runtime dependencies..."
  if ! check_runtime_dependencies; then
    echo "Runtime dependency verification failed — server was not restarted."
    echo "Run the repair command shown above, then re-run './multicc update'."
    return 1
  fi

  echo "Restarting to apply update..."
  if [ -f "$PLIST" ]; then
    # Installed as a launchd service — reload so the new server.js is picked up
    launchctl unload "$PLIST" 2>/dev/null
    launchctl load "$PLIST"
    echo "Service reloaded."
  else
    do_restart
  fi
  if ! wait_for_ready; then
    echo "Update code was applied, but startup migration/readiness needs operator attention."
    return 1
  fi
  echo "Update complete (${before:0:7} → ${after:0:7})."
}

do_install() {
  # Lay down every bundled skill so claude sessions can discover them immediately
  # (the server also re-syncs these on every startup). Any dir under skills/ that
  # contains a SKILL.md is installed — no need to list them here.
  if [ -d "$SCRIPT_DIR/skills" ]; then
    mkdir -p "$HOME/.claude/skills"
    for SKILL_SRC in "$SCRIPT_DIR"/skills/*/; do
      [ -f "$SKILL_SRC/SKILL.md" ] || continue
      SKILL_NAME="$(basename "$SKILL_SRC")"
      SKILL_DEST="$HOME/.claude/skills/$SKILL_NAME"
      rm -rf "$SKILL_DEST"
      cp -R "$SKILL_SRC" "$SKILL_DEST"
      chmod +x "$SKILL_DEST"/bin/* 2>/dev/null || true
      echo "Installed skill → $SKILL_DEST"
    done
  fi

  # Create launchd plist for auto-start on login
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$NODE</string>
    <string>$SCRIPT_DIR/server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$SCRIPT_DIR</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$OUT_LOG</string>
  <key>StandardErrorPath</key>
  <string>$ERR_LOG</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(dirname "$NODE"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
EOF
  # Stop if already loaded
  launchctl unload "$PLIST" 2>/dev/null
  launchctl load "$PLIST"
  echo "MultiCC installed as login service"
  echo "  Auto-starts on login, auto-restarts on crash"
  echo "  Plist: $PLIST"
  echo ""
  echo "  ./multicc restart   — restart service"
  echo "  ./multicc stop      — stop (will auto-restart via KeepAlive)"
  echo "  ./multicc uninstall — remove auto-start"
}

do_uninstall() {
  if [ -f "$PLIST" ]; then
    launchctl unload "$PLIST" 2>/dev/null
    rm -f "$PLIST"
    echo "MultiCC service uninstalled"
  else
    echo "MultiCC service not installed"
  fi
  # Also kill any running instance
  do_stop
}

# ── Main ──
case "${1:-}" in
  start)     do_start ;;
  stop)      do_stop ;;
  restart)   do_restart ;;
  status)    do_status ;;
  log|logs)  do_log ;;
  update)    shift; do_update "$@" ;;
  install)   do_install ;;
  uninstall) do_uninstall ;;
  *)
    echo "MultiCC service manager"
    echo ""
